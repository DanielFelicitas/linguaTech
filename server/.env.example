# Vercel: Project → Settings → Root Directory = `server`. Set MONGO_URI, JWT_SECRET, and chat env vars in the dashboard.

PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
ADMIN_EMAILS=admin@example.com

# Optional: admin file uploads (Vercel-safe — multer memory → Cloudinary), same pattern as student-commission
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Or set all three:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=linguatech

# Chat tutor — use ONE path (HF token checked first if both are set)

# Option A: Hugging Face Inference Router (OpenAI-compatible)
# Token needs "Inference Providers" / API access: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=hf_your_token_here
# Optional: model on the Hub (suffix :fastest picks a provider — see HF docs)
# HF_CHAT_MODEL=HuggingFaceH4/zephyr-7b-beta:fastest
# Optional: override router URL (default is correct for most apps)
# HF_ROUTER_URL=https://router.huggingface.co/v1/chat/completions
# Optional: retries when HF returns 5xx / "Server initialization failed" (default 2)
# HF_CHAT_RETRIES=2

# Option B: OpenAI
# OPENAI_API_KEY=sk-your-key
# OPENAI_MODEL=gpt-3.5-turbo
